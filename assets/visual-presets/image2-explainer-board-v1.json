    "forbiddenGeneratedMarks": [
      "readable Chinese body text",
      "pseudo Chinese or Japanese",
      "random letters",
      "random numbers",
      "watermarks",
      "platform UI",
      "logos",
      "copied named styles",
      "exact source layouts"
    ]
  },
